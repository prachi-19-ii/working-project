<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tasks</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="app-shell">
      <header class="topbar">
        <div class="brand">
          <div class="brand-badge">W</div>
          <span>Women for Change</span>
        </div>
        <nav class="navbar">
          <a href="/dashboard">Dashboard</a>
          <a href="/community">Community</a>
          <a href="/chat">Messages</a>
          <a href="/tasks">Tasks</a>
          <a href="/announcements">Announcements</a>
          <a href="/achievements">Achievements</a>
          <a href="/activity">Activity</a>
          <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
          <a href="/logout">Logout</a>
        </nav>
      </header>

      <main class="page-wrap">
        <section class="card">
          <h2 class="section-title">Assign Task</h2>
          <form action="/tasks" method="POST">
            <div class="form-grid">
              <div>
                <label>Task Title</label>
                <input type="text" name="title" required />
              </div>
              <div>
                <label>Student Email</label>
                <input type="email" name="assignee_email" required />
              </div>
              <div>
                <label>Due Date</label>
                <input type="date" name="due_date" />
              </div>
              <div style="grid-column: 1 / -1;">
                <label>Task Description</label>
                <textarea name="description" required></textarea>
              </div>
              <div style="grid-column: 1 / -1;">
                <button type="submit" class="btn btn-primary">Assign Task</button>
              </div>
            </div>
          </form>
        </section>

        <section class="card" style="margin-top: 28px;">
          <h2 class="section-title">My Assigned Tasks</h2>
          <ul class="list">
            <% tasks.forEach((task) => { %>
              <li class="list-item">
                <strong><%= task.title %></strong>
                <div><%= task.description %></div>
                <div class="muted">Due: <%= task.due_date || 'No due date' %> | Status: <%= task.status %></div>
              </li>
            <% }) %>
          </ul>
        </section>
      </main>
    </div>
  </body>
</html>
