<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Community Directory</title>
    <link rel="stylesheet" href="/styles.css" />
    <script src="/app.js" defer></script>
  </head>
  <body>
    <div class="app-shell">
      <header class="topbar">
        <div class="brand">
          <div class="brand-badge">W</div>
          <span>Women for Change</span>
        </div>
        <nav class="navbar">
          <a href="/dashboard">Dashboard</a>
          <a href="/community">Community</a>
          <a href="/chat">Messages</a>
          <a href="/tasks">Tasks</a>
          <a href="/announcements">Announcements</a>
          <a href="/achievements">Achievements</a>
          <a href="/activity">Activity</a>
          <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
          <a href="/logout">Logout</a>
        </nav>
      </header>

      <main class="page-wrap">
        <section class="card">
          <h2 class="section-title">Community Directory</h2>
          <div class="btn-row" style="margin-top: 0; margin-bottom: 18px;">
            <button class="btn btn-secondary" data-role-filter="all">All</button>
            <button class="btn btn-secondary" data-role-filter="student">Students</button>
            <button class="btn btn-secondary" data-role-filter="alumni">Alumni</button>
            <button class="btn btn-secondary" data-role-filter="mentor">Mentors</button>
            <button class="btn btn-secondary" data-role-filter="teacher">Teachers</button>
          </div>

          <div class="community-grid">
            <% users.forEach((member) => { %>
              <div class="profile-card" data-role-card="<%= member.role %>">
                <div class="avatar"> <%= member.full_name.split(' ').map(name => name[0]).slice(0,2).join('').toUpperCase() %></div>
                <h3><%= member.full_name %></h3>
                <div class="meta-row">
                  <span class="pill"><%= member.role %></span>
                  <span class="pill"><%= member.department || 'Community Member' %></span>
                </div>
                <div class="muted"><%= member.email %></div>
                <div class="btn-row">
                  <a class="btn btn-primary" href="/profile/<%= member.id %>">View profile</a>
                  <a class="btn btn-secondary" href="/chat?user=<%= member.id %>">Message</a>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
