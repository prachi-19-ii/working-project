<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WFC Portal Login</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="auth-wrap">
      <div class="login-box">
        <div class="brand" style="margin-bottom: 16px;">
          <div class="brand-badge">W</div>
          <span>Women for Change</span>
        </div>
        <h1>Welcome back</h1>
        <p class="login-sub">Access the Student, Alumni, Mentor, Teacher, and Admin community portal.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="error-box"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
          <div class="form-grid" style="grid-template-columns: 1fr;">
            <div>
              <label for="email">Email or Username</label>
              <input id="email" name="email" type="text" placeholder="Enter your email" required />
            </div>
            <div>
              <label for="password">Password</label>
              <input id="password" name="password" type="password" placeholder="Enter password" required />
            </div>
            <div>
              <button type="submit" class="btn btn-primary" style="width: 100%;">Login</button>
            </div>
          </div>
        </form>

        <div class="muted" style="margin-top: 16px;">
          Demo accounts:<br>
          admin@wfc.com / Admin@123<br>
          teacher@wfc.com / Teacher@123<br>
          prachiprajapati0512@gmail.com / WFC@123
        </div>
      </div>
    </div>
  </body>
</html>
